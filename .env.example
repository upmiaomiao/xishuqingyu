# 环境变量样例 —— 复制成 .env 再填值；**真 .env 不入库**
#
# 线上实际用到的变量名是从代码里梳理出来的（见下方分组）。
# 值为空的表示"用代码里的默认值即可"，标注「必填」的线上必须给。

# ===== 8011 问答站点 /home/test/xishu_qingyu_serve/.env =====
INTENT_API_KEY=              # 必填：意图识别模型网关的 key
INTENT_MODEL=                # 必填：意图识别用的模型名

# ===== 站点：路径与限额 =====
QA_HOST=0.0.0.0
QA_PORT=8011
MD_ROOT=/data/fagui_rag/okf_bundles
PDF_ROOT=/data/fagui_rag
MD_PREVIEW_MAX=

# ===== 审核引擎（audit/）=====
AUDIT_HOME=/data/eia_audit
AUDIT_CACHE_DIR=
AUDIT_REPORT_DIR=
AUDIT_MAX_UPLOAD_MB=
AUDIT_MODEL_NAME=
AUDIT_MODEL_URL=
# 判据目录：审核与生成共用的 JSON 判据都放这里
EIA_CRITERIA_DIR=/data/fagui_rag/criteria

# ===== 报告生成引擎（gen/）=====
GEN_HOME=/data/eia_report_gen
GEN_CRIT_DIR=/data/fagui_rag/criteria

# ===== 法规 RAG（建索引 / 检索）=====
BUNDLE_ROOT=/data/fagui_rag/okf_bundles
INDEX_DIR=/data/fagui_rag/index
EMBED_URL=                   # 向量服务地址（vllm bge-m3，见 launch_bge_m3_embed_*.sh）
RAG_INDEX_DIR=
RAG_MIN_RERANK=
RAG_STD_PIN=
RAG_STD_PIN_FINAL=
RAG_STD_PIN_POOL=
RAG_ABOLISHED_PENALTY=

# ===== 站点里 openai 兼容客户端（历史遗留，按需填）=====
OPENAI_API_KEY=
